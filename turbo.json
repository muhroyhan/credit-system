{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  },
  "globalPassThroughEnv": [
    "PLAYWRIGHT_BROWSER_PATH",
    "DATABASE_URL",
    "SEED_PASSWORD",
    "JWT_SECRET",
    "DOCUMENT_STORAGE_DIR",
    "WHATSAPP_ACCESS_TOKEN"
  ]
}
