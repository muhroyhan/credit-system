{
  "name": "credit-system",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "start": "bun apps/server/dist/index.js",
    "db:generate": "drizzle-kit generate --config packages/database/drizzle.config.ts",
    "db:migrate": "bun packages/database/src/migrate.ts",
    "db:seed": "bun packages/database/src/seed.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "drizzle-kit": "^0.31.0"
  }
}
