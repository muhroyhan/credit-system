{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!.vscode",
      "!!node_modules",
      "!!**/dist",
      "!!pnpm-lock.yaml",
      "!!docs",
      "!!**/.turbo",
      "!!test-results",
      "!!playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noBannedTypes": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noUnsafeDeclarationMerging": "error"
      },
      "style": {
        "noNamespace": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error"
      },
      "preset": "recommended"
    }
  }
}
